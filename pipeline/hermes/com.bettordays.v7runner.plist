<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bettordays.v7runner</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__ENGINE__/bd_daily_v7.sh</string></array>
  <key>WorkingDirectory</key><string>__ENGINE__</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>40</integer></dict>
  <key>StandardOutPath</key><string>__ENGINE__/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__ENGINE__/launchd.err.log</string>
</dict>
</plist>

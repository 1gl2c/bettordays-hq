{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/history",
      "destination": "/"
    },
    {
      "source": "/results",
      "destination": "/"
    },
    {
      "source": "/method",
      "destination": "/"
    },
    {
      "source": "/easy",
      "destination": "/"
    },
    {
      "source": "/research",
      "destination": "/"
    },
    {
      "source": "/record",
      "destination": "/"
    },
    {
      "source": "/founders",
      "destination": "/"
    },
    {
      "source": "/board",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/refresh.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}